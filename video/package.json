{
  "name": "synclab-launch-video",
  "version": "1.0.0",
  "private": true,
  "description": "25-second SyncLab product video: real footage captured frame by frame, edited in Remotion, with locally generated music.",
  "scripts": {
    "capture": "node capture/capture.mjs",
    "music": "python3 music/compose.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SyncLabLaunch out/synclab-launch-2560x1440.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k --concurrency=4 --x264-preset=slow",
    "still": "remotion still src/index.ts SyncLabLaunch"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.536",
    "geist": "1.5.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
