{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @synclab/shared build && pnpm --filter @synclab/server build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @synclab/server start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 20,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
